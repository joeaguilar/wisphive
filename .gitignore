# Python bytecode cache
__pycache__/
*.pyc

# Impeccable skill local artifacts (durable outputs — PRODUCT.md, DESIGN.md,
# .impeccable/design.json, .impeccable/live/config.json — are committed).
**/.impeccable/hook.cache.json
**/.impeccable/config.local.json

# Transient Playwright-MCP browser output (console logs, screenshots)
.playwright-mcp/

# SQLite sidecars for the itr tracker DB
.itr.db-*

# Regenerated e2e evidence under campaign/ and sprint/: screenshots and run
# logs that `just e2e` overwrites in place on every run (timestamps + temp
# paths churn, nothing else). Working copies stay on disk; the reviewed
# snapshots remain in git history. Hand-written .txt artifacts stay tracked.
campaign/**/*.png
sprint/**/*.png
campaign/**/*-e2e.txt
sprint/**/*-e2e.txt

# Stray root npm lockfile (frontend lockfile lives in crates/wisphive_web/frontend)
/package-lock.json

# Symlink into the external skills repo
.claude/workflows
